# ============ Luba AI Pro v18 — copie ce fichier en .env et remplis les valeurs ============
NODE_ENV=production
PORT=3000
DATA_DIR=./data
ALLOWED_ORIGINS=https://ton-site.com
HMAC_SECRET=change-moi-secret-long
METRICS_TOKEN=change-moi
LOG_LEVEL=info

# ---- Firebase (authentification) ----
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Modèles gratuits : plusieurs clés par fournisseur = plus de quota ----
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# ---- Sources (v18) ----
# Google Search : serveur OpenSERP auto-hébergé (pas un paquet npm)
OPENSERP_URL=
OPENSERP_LANG=FR
# Facultatifs : meilleures recherches web / YouTube
SERPER_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# ---- Stabilité (valeurs par défaut conseillées) ----
CONTEXT_TOKEN_BUDGET=9000
MODERATION_REMOTE=false
MAX_CONTINUATIONS=3
CODE_MAX_TOKENS=12000
DUAL_MODEL=true

# ---- Fichiers joints ----
MAX_FILES_PER_REQUEST=4
MAX_FILE_SIZE_MB=15
MAX_PDF_PAGES=60

# ---- Luba Live ----
LUBA_LIVE_ENABLED=true
LIVE_MAX_TOKENS=380
KOKORO_URL=
LIVE_TTS_VOICE=ff_siwis
PIPER_URL=
