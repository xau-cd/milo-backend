rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      // Profil : le propriétaire lit / modifie uniquement SES champs autorisés.
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'emailVerified', 'lastLogin', 'privacyPolicyAccepted', 'privacyPolicyAcceptedAt'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid);

      // Discussions : lecture seule pour le propriétaire. Seul le backend (Admin SDK, qui ignore ces règles) écrit.
      match /conversations/{convId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /messages/{msgId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    // Tout le reste est interdit.
    match /{document=**} { allow read, write: if false; }
  }
}
